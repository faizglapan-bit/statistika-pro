# ==============================================================================
# STATISTIKA PRO — Environment Configuration Template
# ==============================================================================
# Salin file ini ke .env (di root proyek atau di apps/api & apps/web)
# JANGAN memasukkan secret, password, atau API key riil ke file ini.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Pilihan: development | production | testing
# - development : Mengaktifkan API docs (/api/docs), logging verbose, reload
# - production  : Menonaktifkan docs publik, CORS ketat, sanitasi error stack
APP_ENV=development

# Level logging Python: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
# HOST binding:
# - Local Mode  : WAJIB gunakan 127.0.0.1 agar tidak terekspos ke jaringan publik
# - Online Mode : Gunakan 0.0.0.0 di dalam kontainer Docker di belakang reverse proxy
API_HOST=127.0.0.1
API_PORT=8000

# ------------------------------------------------------------------------------
# 3. CORS ORIGINS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Daftar origin frontend yang diizinkan, pisahkan dengan koma tanpa spasi.
# Local Mode : http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
# Online Mode: https://statpro.example.com (sesuaikan dengan domain Anda)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173

# ------------------------------------------------------------------------------
# 4. STORAGE & DATA DIRECTORIES
# ------------------------------------------------------------------------------
# Lokasi penyimpanan dataset dan proyek lokal / volume server.
# Relatif terhadap direktori apps/api atau path absolut persisten.
DATA_DIR=data
PROJECTS_DIR=data/projects

# Batas unggah file (MB) dan batas ukuran baris/kolom dataset
UPLOAD_MAX_SIZE_MB=50
MAX_DATASET_ROWS=100000
MAX_DATASET_COLS=500

# Sanitasi formula injection pada ekspor CSV (menolak eksekusi formula di Excel)
SAFE_FORMULA_ESCAPE=true

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (React / Vite)
# ------------------------------------------------------------------------------
# URL API backend yang diakses oleh frontend:
# - Local Dev / Reverse Proxy: Kosongkan atau gunakan http://127.0.0.1:8000
# - Standalone Local Build   : http://127.0.0.1:8000
# - Production Nginx Proxy   : Biarkan kosong (menggunakan relative /api)
VITE_API_URL=
